    {
      "name": "8. Historial de Logs",
      "item": [
        {
          "name": "GET — Logs de una reserva",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/reservations/{{idReservation}}/logs", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "{{idReservation}}", "logs"] }
          }
        }
      ]
    },
    {
      "name": "9. MS-SCHEDULE — Reservation Blocks",
      "item": [
        {
          "name": "POST — Crear bloqueo de horario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idAcademicSpace\": 1,\n  \"date\": \"2026-06-10\",\n  \"startTime\": \"10:00:00\",\n  \"endTime\": \"12:00:00\",\n  \"idReservation\": 1\n}"
            },
            "url": { "raw": "http://localhost:8084/api/v1/schedules/reservation-blocks", "host": ["localhost"], "port": "8084", "path": ["api", "v1", "schedules", "reservation-blocks"] }
          }
        },
        {
          "name": "DELETE — Liberar bloqueo de horario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "http://localhost:8084/api/v1/schedules/reservation-blocks/1", "host": ["localhost"], "port": "8084", "path": ["api", "v1", "schedules", "reservation-blocks", "1"] }
          }
        },
        {
          "name": "GET — Verificar disponibilidad de horario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8084/api/v1/schedules/reservation-blocks/availability?idAcademicSpace=1&date=2026-06-10&startTime=10:00:00&endTime=12:00:00",
              "host": ["localhost"], "port": "8084",
              "path": ["api", "v1", "schedules", "reservation-blocks", "availability"],
              "query": [
